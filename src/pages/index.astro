---
import '../styles/global.css';
import '../styles/index.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const base = import.meta.env.BASE_URL;
const home = base.endsWith('/') ? base : `${base}/`;
const pageTitle = 'Ferx Technologies — FerxFlow';
const description =
  'FerxFlow is project planning and workflow management for teams that want clarity from idea to delivery.';
const canonical = new URL(home, Astro.site);

const products = [
  {
    id: 'ferxflow',
    name: 'FerxFlow',
    accent: '#1d4ed8',
    tint: '#eff4ff',
    description: 'Project planning and workflow management for teams that want clarity from idea to delivery.',
  },
];

const tasks = {
  todo: [
    { title: 'Map release checklist', type: 'Story', priority: 'High' },
    { title: 'Write onboarding notes', type: 'Doc', priority: 'Med' },
  ],
  progress: [
    { title: 'API access review', type: 'Task', priority: 'High' },
    { title: 'Sprint demo outline', type: 'Story', priority: 'Low' },
  ],
  done: [
    { title: 'Service catalog draft', type: 'Task', priority: 'Med' },
    { title: 'Team standup template', type: 'Doc', priority: 'Low' },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Ferx Technologies" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href={`${home}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <div class="announce" role="region" aria-label="Announcement">
      <p>
        FerxFlow is here — plan and track work from idea to delivery.
        <a href={`${home}#ferxflow`}>Explore FerxFlow <span aria-hidden="true">→</span></a>
      </p>
    </div>

    <SiteHeader />

    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">FerxFlow</p>
            <h1 id="hero-title">Plan the work. Ship it.</h1>
            <p class="lede">{description}</p>
            <div class="cta-row">
              <a class="btn btn-primary" href={`${home}contact`}>Get started</a>
              <a class="btn btn-secondary" href={`${home}#ferxflow`}>Explore FerxFlow</a>
            </div>
          </div>

          <div class="board" aria-hidden="true">
            <div class="board-top">
              <div>
                <p class="board-kicker">FerxFlow</p>
                <h2>Release planning</h2>
              </div>
              <div class="progress">
                <div class="progress-meta">
                  <span>Sprint 14</span>
                  <span>68%</span>
                </div>
                <div class="progress-track"><span style="width: 68%"></span></div>
              </div>
            </div>
            <div class="board-cols">
              <div class="col">
                <h3>To do <span>2</span></h3>
                {tasks.todo.map((task) => (
                  <article class="task">
                    <p>{task.title}</p>
                    <div class="task-meta">
                      <span class="pill">{task.type}</span>
                      <span class={`pill pri-${task.priority.toLowerCase()}`}>{task.priority}</span>
                      <span class="avatars" title="Assigned teammates">
                        <span>AL</span><span>MK</span>
                      </span>
                    </div>
                  </article>
                ))}
              </div>
              <div class="col">
                <h3>In progress <span>2</span></h3>
                {tasks.progress.map((task) => (
                  <article class="task">
                    <p>{task.title}</p>
                    <div class="task-meta">
                      <span class="pill">{task.type}</span>
                      <span class={`pill pri-${task.priority.toLowerCase()}`}>{task.priority}</span>
                      <span class="avatars"><span>JR</span><span>PS</span></span>
                    </div>
                  </article>
                ))}
              </div>
              <div class="col">
                <h3>Done <span>2</span></h3>
                {tasks.done.map((task) => (
                  <article class="task">
                    <p>{task.title}</p>
                    <div class="task-meta">
                      <span class="pill">{task.type}</span>
                      <span class={`pill pri-${task.priority.toLowerCase()}`}>{task.priority}</span>
                      <span class="avatars"><span>TN</span></span>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="products" class="section" aria-labelledby="products-title">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">Product</p>
            <h2 id="products-title">FerxFlow for how your team plans work</h2>
          </div>
          <div class="product-grid">
            {products.map((product) => (
              <article id={product.id} class="product-card" style={`--accent:${product.accent};--tint:${product.tint}`}>
                <div class="product-icon" aria-hidden="true">
                  <svg viewBox="0 0 32 32"><rect x="4" y="6" width="8" height="20" rx="2"></rect><rect x="14" y="6" width="6" height="12" rx="2"></rect><rect x="22" y="6" width="6" height="16" rx="2"></rect></svg>
                </div>
                <h3>{product.name}</h3>
                <p>{product.description}</p>
                <a href={`${home}#${product.id}`}>Learn more <span aria-hidden="true">→</span></a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="why-ferx" class="section why" aria-labelledby="why-title">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">Why Ferx?</p>
            <h2 id="why-title">Everything your team needs to work better.</h2>
          </div>
          <div class="why-grid">
            <article>
              <div class="line-icon" aria-hidden="true">
                <svg viewBox="0 0 32 32"><circle cx="8" cy="16" r="3"></circle><circle cx="24" cy="8" r="3"></circle><circle cx="24" cy="24" r="3"></circle><path d="M11 15l10-6M11 17l10 6"></path></svg>
              </div>
              <h3>One place for the work</h3>
              <p>Keep backlog, sprints, and delivery status in FerxFlow.</p>
            </article>
            <article>
              <div class="line-icon" aria-hidden="true">
                <svg viewBox="0 0 32 32"><rect x="5" y="8" width="9" height="16" rx="2"></rect><rect x="18" y="8" width="9" height="7" rx="2"></rect><rect x="18" y="17" width="9" height="7" rx="2"></rect></svg>
              </div>
              <h3>Built for the way teams work</h3>
              <p>Flexible tools that adapt to software, IT, and business teams.</p>
            </article>
            <article>
              <div class="line-icon" aria-hidden="true">
                <svg viewBox="0 0 32 32"><path d="M6 22c4-8 6-8 10-4s6 4 10-6"></path><path d="M20 8h6v6"></path></svg>
              </div>
              <h3>Clear from idea to done</h3>
              <p>See what is planned, in progress, and finished without extra tools.</p>
            </article>
          </div>
        </div>
      </section>

      <section id="solutions" class="section" aria-labelledby="solutions-title">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">Solutions</p>
            <h2 id="solutions-title">Work that fits the team in front of it</h2>
          </div>
          <div class="solution-grid">
            <article id="software-teams" class="solution solution-soft">
              <h3>Software teams</h3>
              <p>Plan releases, manage sprints, and ship with a shared board in FerxFlow.</p>
              <a href={`${home}#ferxflow`}>See how it works <span aria-hidden="true">→</span></a>
            </article>
            <article id="it-teams" class="solution solution-it">
              <h3>IT teams</h3>
              <p>Track internal projects, requests, and delivery work in one FerxFlow board.</p>
              <a href={`${home}#ferxflow`}>See how it works <span aria-hidden="true">→</span></a>
            </article>
            <article id="business-teams" class="solution solution-biz">
              <h3>Business teams</h3>
              <p>Turn goals into projects and keep status visible in FerxFlow.</p>
              <a href={`${home}#ferxflow`}>See how it works <span aria-hidden="true">→</span></a>
            </article>
          </div>
        </div>
      </section>

      <section class="proof" aria-labelledby="proof-title">
        <div class="container">
          <h2 id="proof-title">Teams use FerxFlow to keep work moving</h2>
          <p class="proof-note">Illustrative marketing statistics for this launch site.</p>
          <dl class="stats">
            <div><dt>10K+ teams connected</dt><dd>Teams on FerxFlow</dd></div>
            <div><dt>2M+ work items managed</dt><dd>Work tracked in FerxFlow</dd></div>
            <div><dt>35% faster delivery</dt><dd>Reported delivery pace</dd></div>
            <div><dt>99.9% availability</dt><dd>Target availability</dd></div>
          </dl>
          <p class="logo-label">Example customer wordmarks</p>
          <ul class="logos" aria-label="Example customer names">
            <li>Northstar</li>
            <li>Orbit Labs</li>
            <li>Vertex</li>
            <li>Acme Systems</li>
            <li>Brightline</li>
          </ul>
        </div>
      </section>

      <section class="banner" aria-labelledby="banner-title">
        <div class="container banner-inner">
          <h2 id="banner-title">Make work work better.</h2>
          <p>Plan and track delivery with FerxFlow from Ferx Technologies.</p>
          <div class="cta-row">
            <a class="btn btn-light" href={`${home}contact`}>Start building</a>
            <a class="btn btn-outline-light" href={`${home}contact`}>Talk to our team</a>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
