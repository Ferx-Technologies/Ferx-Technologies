---
import '../styles/global.css';
import '../styles/index.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const base = import.meta.env.BASE_URL;
const home = base.endsWith('/') ? base : `${base}/`;
const title = 'Contact Ferx Technologies';
const description = 'Talk with the Ferx Technologies team about getting started, security, careers, and product resources.';
const canonical = new URL(`${home}contact`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href={`${home}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" class="page">
      <div class="container page-card">
        <p class="eyebrow">Ferx Technologies</p>
        <h1>Talk with our team</h1>
        <p class="lede">
          Sign-in, onboarding, and the resource center are opening with the platform. Until then, this page is the place to reach us.
        </p>
        <form class="contact-form" action={`${home}contact`} method="get">
          <label>
            Work email
            <input type="email" name="email" autocomplete="email" required placeholder="you@company.com" />
          </label>
          <label>
            How can we help?
            <textarea name="message" rows="4" required placeholder="Tell us about your team"></textarea>
          </label>
          <button class="btn btn-primary" type="submit">Send message</button>
        </form>
        <div class="info-grid">
          <section id="about"><h2>About</h2><p>Ferx Technologies builds FerxFlow for software, IT, and business teams.</p></section>
          <section id="careers"><h2>Careers</h2><p>We are preparing our first open roles. Send a note if you want to hear when they go live.</p></section>
          <section id="security"><h2>Security</h2><p>Security reviews, access controls, and availability practices will be published with the product launch.</p></section>
          <section id="documentation"><h2>Documentation</h2><p>FerxFlow product guides are on the way.</p></section>
          <section id="help"><h2>Help center</h2><p>FerxFlow support articles will live here.</p></section>
          <section id="blog"><h2>Blog</h2><p>Stories about how teams plan, support, and share work will be published here.</p></section>
          <section id="status"><h2>Status</h2><p>FerxFlow status will be reported here. The launch target is 99.9% availability.</p></section>
          <section id="privacy"><h2>Privacy</h2><p>This marketing site does not store account data. A full privacy notice will ship with the product.</p></section>
          <section id="terms"><h2>Terms</h2><p>Terms of use will be published before customer accounts open.</p></section>
        </div>
        <p><a href={home}>Back to the homepage</a></p>
      </div>
    </main>
    <SiteFooter />
  </body>
</html>
